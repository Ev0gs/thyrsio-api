# Superutilisateur Postgres (admin uniquement, pas pour l'appli)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=thyrsio
POSTGRES_PORT=5432

# Rôle lu par le backend pour consulter le registre des tenants
THYRSIO_APP_PASSWORD=admin

# pgAdmin
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
# Copier en .env (cp .env.example .env), remplir, puis : chmod 600 .env
# Des secrets longs et différents pour chaque ligne : openssl rand -base64 32

# ---------- Les adresses (les deux enregistrements DNS doivent pointer vers le serveur) ----------
APP_DOMAIN=app.mondomaine.fr
AUTH_DOMAIN=auth.mondomaine.fr
# Pour Let's Encrypt (avertissements d'expiration des certificats)
ACME_EMAIL=moi@mondomaine.fr

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=thyrsio
# Le rôle de l'application (créé au premier démarrage par ../init/01-roles.sh)
THYRSIO_APP_PASSWORD=
# Le rôle de Keycloak (../init/02-keycloak.sh)
KEYCLOAK_DB_PASSWORD=

# ---------- Keycloak ----------
# Le compte de la console d'administration (realm master)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Le secret du client thyrsio-api-admin : l'API s'en sert pour créer les comptes des utilisateurs
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Les adresses IP qui peuvent ouvrir la console d'administration (https://AUTH_DOMAIN/admin),
# séparées par des espaces, par exemple celle du bureau : 203.0.113.10. Vide : personne depuis Internet
KEYCLOAK_ADMIN_ALLOWED_IPS=

# ---------- Les e-mails (mot de passe oublié, invitation des utilisateurs) ----------
# Le SMTP de votre fournisseur (offre e-mail OVH, Brevo...)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=no-reply@mondomaine.fr
SMTP_PASSWORD=
SMTP_FROM=no-reply@mondomaine.fr

# ---------- Les sauvegardes ----------
BACKUP_DIR=/var/backups/thyrsio
BACKUP_KEEP_DAYS=14
# Une copie hors du serveur avec rclone (remote configuré par rclone config), ex. ovh-s3:thyrsio-backups
# Vide : sauvegardes locales seulement (déconseillé)
RCLONE_REMOTE=
